# LootGO: Fee Hunt — Vercel Environment Variables
# Set these in Vercel Dashboard → Settings → Environment Variables

# ─── Database (AWS RDS) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>

# ─── Solana ─────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
PLATFORM_WALLET_ADDRESS=<devnet_wallet_pubkey>
PLATFORM_WALLET_PRIVATE_KEY=<devnet_wallet_private_key_base58>

# ─── Bags API ────────────────────────────────────────────────────────────────
BAGS_API_KEY=<from_dev.bags.fm>
BAGS_API_BASE_URL=https://public-api-v2.bags.fm/api/v1

# ─── Fee Config ──────────────────────────────────────────────────────────────
PLATFORM_FEE_PCT=0.25
PLAYER_FEE_PCT=0.75
AUTO_CLAIM_THRESHOLD_SOL=0.1
MIN_BOX_VALUE_USD=0.10

# ─── Cron Security ───────────────────────────────────────────────────────────
# Random secret — Vercel passes this automatically to cron requests
CRON_SECRET=<generate_random_string>

# ─── LootGO Distribution API (TBD) ──────────────────────────────────────────
LOOTGO_DISTRIBUTION_API_URL=https://api.lootgo.io/v1
LOOTGO_DISTRIBUTION_API_KEY=<TBD_from_Jyam>
