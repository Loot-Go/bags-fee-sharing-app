# LootGO Fee Hunt — Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ─── Solana (Devnet) ────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
# LootGO platform wallet that receives fees and executes buybacks
PLATFORM_WALLET_ADDRESS=<your_devnet_wallet_pubkey>
PLATFORM_WALLET_PRIVATE_KEY=<your_devnet_wallet_private_key_base58>

# ─── Bags API ───────────────────────────────────────────────────────────────
# Get your API key at: https://dev.bags.fm
BAGS_API_KEY=<your_bags_api_key>
BAGS_API_BASE_URL=https://public-api-v2.bags.fm/api/v1

# ─── Database (AWS RDS PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>

# ─── Fee Configuration ──────────────────────────────────────────────────────
# Of LootGO's co-creator share:
#   25% = platform fee (LootGO keeps)
#   75% = player amount (goes to buyback → loot boxes)
PLATFORM_FEE_PCT=0.25
PLAYER_FEE_PCT=0.75

# Auto-claim trigger threshold in SOL (~$10 at $100/SOL)
AUTO_CLAIM_THRESHOLD_SOL=0.1

# Minimum loot box value in USD (skip distribution if below this per-box)
MIN_BOX_VALUE_USD=0.10

# ─── Cron ───────────────────────────────────────────────────────────────────
# Claim cycle schedule (cron syntax) — default: every hour
CLAIM_CRON_SCHEDULE=0 * * * *

# Alert after this many consecutive failures
MAX_CONSECUTIVE_FAILURES=3

# ─── LootGO Distribution API (TBD) ─────────────────────────────────────────
# TODO: Fill in when real API is confirmed
LOOTGO_DISTRIBUTION_API_URL=https://api.lootgo.io/v1
LOOTGO_DISTRIBUTION_API_KEY=<your_lootgo_distribution_api_key>

# ─── Alerts (Optional) ──────────────────────────────────────────────────────
# TODO: Uncomment when alert webhook is set up
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
